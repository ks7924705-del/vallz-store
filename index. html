                    baseDislikes++;
                    btnDislike.classList.add('bg-red-500/20', 'border-red-500', 'text-red-300');
                    iconDislike.className = 'fa-solid fa-thumbs-down text-red-400';
                }
                userVote = type;
            }

            likeCountEl.innerText = baseLikes;
            dislikeCountEl.innerText = baseDislikes;
        }

