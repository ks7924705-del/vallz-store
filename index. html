        // Like / Dislike Toggle Handler State
        let userVote = null; // null, 'like', 'dislike'
        let baseLikes = 142;
        let baseDislikes = 2;

        function handleFeedback(type) {
            const btnLike = document.getElementById('btn-like');
            const btnDislike = document.getElementById('btn-dislike');
            const iconLike = document.getElementById('icon-like');
            const iconDislike = document.getElementById('icon-dislike');
            const likeCountEl = document.getElementById('like-count');
            const dislikeCountEl = document.getElementById('dislike-count');

            if (userVote === type) {
                // Undo vote if clicking the same button again
                if (type === 'like') {
                    baseLikes--;
                    btnLike.classList.remove('bg-accentBlue-500/20', 'border-accentBlue-500', 'text-accentBlue-300');
                    iconLike.className = 'fa-regular fa-thumbs-up text-accentBlue-400';
                } else {
                    baseDislikes--;
                    btnDislike.classList.remove('bg-red-500/20', 'border-red-500', 'text-red-300');
                    iconDislike.className = 'fa-regular fa-thumbs-down text-red-400';
                }
                userVote = null;
            } else {
                // If switching or voting fresh
                if (userVote === 'like') {
                    baseLikes--;
                    btnLike.classList.remove('bg-accentBlue-500/20', 'border-accentBlue-500', 'text-accentBlue-300');
                    iconLike.className = 'fa-regular fa-thumbs-up text-accentBlue-400';
                } else if (userVote === 'dislike') {
                    baseDislikes--;
                    btnDislike.classList.remove('bg-red-500/20', 'border-red-500', 'text-red-300');
                    iconDislike.className = 'fa-regular fa-thumbs-down text-red-400';
                }

                if (type === 'like') {
                    baseLikes++;
                    btnLike.classList.add('bg-accentBlue-500/20', 'border-accentBlue-500', 'text-accentBlue-300');
                    iconLike.className = 'fa-solid fa-thumbs-up text-accentBlue-400';
